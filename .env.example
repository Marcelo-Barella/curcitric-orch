# Web (Next.js) — also copy NEXT_PUBLIC_* into apps/web/.env.local for `pnpm --filter web dev`
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Worker — Postgres connection string (Supabase: Project Settings → Database → Connection string, URI mode)
DATABASE_URL=
WORKER_ID=
POLL_INTERVAL_MS=2000

# GitHub App (server-side integrations; PEM may use \n escapes in .env)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
